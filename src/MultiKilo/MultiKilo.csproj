<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>Assets\MultiKilo.ico</ApplicationIcon>
    <AssemblyName>MultiKilo</AssemblyName>
    <RootNamespace>MultiKilo</RootNamespace>
    <DefineConstants>$(DefineConstants);WPF</DefineConstants>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PatchedTerminalDll>$(MSBuildThisFileDirectory)..\..\artifacts\terminal\win-x64\Microsoft.Terminal.Control.dll</PatchedTerminalDll>
    <PatchedTerminalConnectionDll>$(MSBuildThisFileDirectory)..\..\artifacts\terminal\win-x64\TerminalConnection.dll</PatchedTerminalConnectionDll>
    <PatchedOpenConsoleExe>$(MSBuildThisFileDirectory)..\..\artifacts\terminal\win-x64\OpenConsole.exe</PatchedOpenConsoleExe>
    <PatchedOpenConsoleProxyDll>$(MSBuildThisFileDirectory)..\..\artifacts\terminal\win-x64\OpenConsoleProxy.dll</PatchedOpenConsoleProxyDll>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TerminalWpfPatched\TerminalWpfPatched.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\MultiKilo.ico" />
    <None Include="$(PatchedTerminalDll)" Link="Microsoft.Terminal.Control.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="$(PatchedTerminalConnectionDll)" Link="TerminalConnection.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="$(PatchedOpenConsoleExe)" Link="OpenConsole.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="$(PatchedOpenConsoleProxyDll)" Link="OpenConsoleProxy.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <Target Name="RequirePatchedTerminal" BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true' and (!Exists('$(PatchedTerminalDll)') or !Exists('$(PatchedTerminalConnectionDll)') or !Exists('$(PatchedOpenConsoleExe)') or !Exists('$(PatchedOpenConsoleProxyDll)'))">
    <Error Text="Patched terminal native DLLs are missing. Run eng\windows-terminal\Build-PatchedTerminal.ps1 first." />
  </Target>
</Project>
