<Window x:Class="MultiKilo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MultiKilo"
        Icon="/Assets/MultiKilo.ico"
        Width="1120"
        Height="720"
        MinWidth="760"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Closing="OnWindowClosing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Margin="12,12,12,8"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="PROJECTS"/>

            <ListBox x:Name="ProjectsList"
                     Grid.Row="1"
                     Margin="6,0,6,6"
                     BorderThickness="0"
                     Background="Transparent"
                     SelectionChanged="OnProjectSelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Folder}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Grid.Row="2"
                    Margin="8,2,8,10"
                    HorizontalAlignment="Stretch"
                    Content="+ New Project"
                    Click="OnNewProjectClick"
                    ToolTip="Choose a folder and start Kilo in it."/>
        </Grid>

        <Border Grid.Column="1" Background="{StaticResource BorderBrush}"/>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="12,9,10,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ProjectNameText"
                               FontWeight="SemiBold"
                               Text="No project selected"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock x:Name="ProjectStatusText"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="Stopped"/>
                        <TextBlock Margin="7,0" Foreground="{StaticResource MutedTextBrush}" Text="·"/>
                        <TextBlock x:Name="ProjectFolderText"
                                   MaxWidth="470"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="StartButton"
                            Content="Start / Resume"
                            Click="OnStartResumeClick"/>
                    <Button x:Name="RestartButton"
                            Content="Restart"
                            Click="OnRestartClick"/>
                    <Button x:Name="TerminateButton"
                            Content="Terminate"
                            Click="OnTerminateClick"/>
                    <Button x:Name="RemoveButton"
                            Margin="0"
                            Content="Remove"
                            Click="OnRemoveClick"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource BorderBrush}"/>

            <Grid Grid.Row="2" Background="#0C0C0C">
                <Grid x:Name="TerminalHostGrid"/>
                <Border x:Name="TerminalPlaceholder" Background="#0C0C0C">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#8A8A8A"
                               Text="Select or start a project."/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
